# What configure builds (./configure --help): yes or no.  The core is always
# built; the MPI layer, the CUDA front and NCCL's front in it if configure
# found what they need.
MANA_MPI = @MANA_MPI@
MANA_CUDA = @MANA_CUDA@
MANA_NCCL = @MANA_NCCL@
CUDA_HOME = @CUDA_HOME@
# cuBLAS, cuFFT and cuRAND, whose fronts the CUDA front builds if they are
# there (at NERSC, the HPC SDK's math_libs); empty: next to libcudart.
CUDA_MATH_LIBDIR ?= @CUDA_MATH_LIBDIR@
# NCCL, whose front the CUDA front builds with MANA_NCCL: its library
# (libnccl.so.N) and the directory of nccl.h.
NCCL_LIB = @NCCL_LIB@
NCCL_INCLUDE = @NCCL_INCLUDE@

# The plain compilers, for what must not be linked with MPI (libmana.so,
# bin/lower-half-nompi, libmpistub.so, the LD_AUDIT modules, dlopen_mpi).
# Make's default, cc, is the MPI compiler wrapper on Cray systems; with
# craype-accel-nvidia80, it links even a -nostdlib library with libcuda and
# the GTL.
CC = @CC@
CXX = @CXX@
CFLAGS = @CFLAGS@
CXXFLAGS = @CXXFLAGS@
FFLAGS = ${CXXFLAGS} @FFLAGS@

PLATFORM=${shell echo $$HOST}

# Mark the platform as Perlmutter for a compute node.
ifeq ($(findstring nid0,$(PLATFORM)),nid0)
IS_PERLMUTTER = 1
endif
# Perlmutter's login node starts with login keyword
ifeq ($(findstring login,$(PLATFORM)),login)
IS_PERLMUTTER = 1
endif

# The MPI compilers that configure found (MPICC, MPICXX, ... --with-mpi).
MPICC = @MPICC@
MPICXX = @MPICXX@ -std=c++20
MPIFORTRAN = @MPIFORTRAN@
MPIRUN = @MPIRUN@

ifeq (${IS_PERLMUTTER}, 1)
  MPI_LD_FLAG = -lmpich
  MPI_CFLAGS?= @CFLAGS@ -g3 -fPIC
  MPI_CXXFLAGS?= @CXXFLAGS@ -g3 -fPIC
  MPI_LDFLAGS?= -dynamic
# This is needed, or else mana_coordinator.o becomes the default target.
default2: default
#mana_coordinator.o: mana_coordinator.cpp
#	${CXX} ${CXXFLAGS} `CC --cray-print-opts=cflags` -c -o $@ $<
## On Perlmutter, the generic settings of 'else' seem to work.
else
  # FIXME: The following paths are hardwired for non-NERSC platforms on which
  # MPICH and other extra libraries are installed from source.
  # Eventually, the LD_FLAGS for MPI should be configured in the
  # `../configure-mana` script.
  MPI_LD_FLAG = -L$$HOME/mpich-static/usr/lib64 -lmpi -L$$HOME/local_install/lib -llzma -lz -lm -lxml2
  MPI_CFLAGS?= @CFLAGS@ -g3 -fPIC
  MPI_CXXFLAGS?= @CXXFLAGS@ -g3 -fPIC
  MPI_FFLAGS = @FFLAGS@ -g3
  MPI_LDFLAGS?=
endif
